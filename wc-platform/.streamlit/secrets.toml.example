# Copy to secrets.toml and fill in. secrets.toml is gitignored.
# Streamlit Cloud: paste these into the app's Secrets settings instead
# (Settings -> Secrets), not into a file in the repo.

# Shared access password. The app refuses all access until this is set -
# it fails closed, because an unset password on a public URL would leave
# real client data reachable by anyone with the link.
APP_PASSWORD = ""

# Optional. Without it the Client Summary falls back to its deterministic
# template; everything else in the report is unaffected.
ANTHROPIC_API_KEY = "sk-ant-..."
